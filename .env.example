# Metadata Service Configuration
METADATA__DATABASE__URL=postgresql://corecrm:corecrm_password@localhost:5432/corecrm_metadata
METADATA__DATABASE__MAX_CONNECTIONS=10
METADATA__SERVER__HOST=0.0.0.0
METADATA__SERVER__PORT=8001

# API Gateway Configuration
GATEWAY__SERVER__HOST=0.0.0.0
GATEWAY__SERVER__PORT=8000
GATEWAY__METADATA_SERVICE_URL=http://localhost:8001

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_USER=corecrm
POSTGRES_PASSWORD=corecrm_password
POSTGRES_DB=corecrm_metadata

# Logging
RUST_LOG=info,metadata_service=debug,api_gateway=debug
